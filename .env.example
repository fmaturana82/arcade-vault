# SPEC 03 — envío del formulario de contacto con Resend.
# Copia este archivo a .env.local y rellena los valores.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Opcional. Sin dominio verificado, Resend solo entrega al correo de tu cuenta.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"

# SPEC 04 — Supabase (públicas: la publishable key puede ir al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
